# MemOmics-Agent Environment Variables
# Copy this file to .env and edit values
# Or export them in your shell before starting

# === LLM API (required — or configure via WebUI first-run wizard) ===
# MEMOMICS_API_KEY=sk-your-api-key-here
# MEMOMICS_BASE_URL=https://api.deepseek.com/v1
# MEMOMICS_MODEL=deepseek-chat
# MEMOMICS_PROVIDER=openai

# === Server ===
# MEMOMICS_PORT=8899

# === Web Search Backend (optional) ===
# Default: ddgs (DuckDuckGo, free, no key needed)
# Options: ddgs, tavily, exa, searxng, brave-free
# TAVILY_API_KEY=tvly-xxxxx
# EXA_API_KEY=xxxxx
# SEARXNG_URL=http://localhost:8080
# BRAVE_SEARCH_API_KEY=xxxxx

# === R (optional — auto-detected) ===
# R_HOME=/usr/lib/R
