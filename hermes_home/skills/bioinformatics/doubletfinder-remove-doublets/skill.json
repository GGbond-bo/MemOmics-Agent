    "pK优化曲线",
    "UMAP双胞图",
    "过滤后对象"
  ],
  "parameters": {
    "pN": "0.25",
    "pK": "auto(BCparamOpt)",
    "nExp_poi": "auto(细胞数*0.008*千细胞数)"
