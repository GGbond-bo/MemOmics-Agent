{
  "id": "count_objects",
  "version": "1.0.2",
  "name": "颗粒/细胞核计数与密度",
  "summary": "阈值 → 可选分水岭 → 按面积/圆度过滤计数，输出逐对象 CSV + 轮廓图 + 密度（个/mm²，需 px_um）。适用于 DAPI 核计数、CD31 毛细血管计数、中央核计数（配合 ROI）。",
  "status": "ready",
  "requires": [],
  "template": "macro.ijm.tmpl",
  "outputs": [
    "objects.csv",
    "outlines.png",
    "mask.png"
  ],
  "params": {
    "px_um": {
      "type": "number",
      "default": 0,
      "desc": "物理像素尺寸（µm/px）；0 = 用图像自带标定"
    },
    "channel": {
      "type": "int",
      "default": 1,
      "min": 1,
      "max": 5,
      "desc": "多通道图取第几通道"
    },
    "threshold": {
      "type": "string",
      "default": "Otsu",
      "enum": [
        "Otsu",
        "Triangle",
        "Yen",
        "Li",
        "Mean",
        "Default",
        "Huang",
        "Intermodes",
        "IsoData",
        "MaxEntropy",
        "MinError",
        "Minimum",
        "Moments",
        "Percentile",
        "RenyiEntropy",
        "Shanbhag"
      ],
      "desc": "自动阈值方法"
    },
    "smooth": {
      "type": "number",
      "default": 0,
      "desc": "高斯模糊 sigma（像素）：先降噪再阈值，噪声大的 12/16-bit 图给 1.5–3"
    },
    "invert": {
      "type": "bool",
      "default": false,
      "desc": "前景暗、背景亮时置 true"
    },
    "watershed": {
      "type": "bool",
      "default": true,
      "desc": "分水岭拆粘连"
    },
    "project": {
      "type": "bool",
      "default": true,
      "desc": "Z 堆栈先最大强度投影"
    },
    "min_area_um2": {
      "type": "number",
      "default": 20,
      "desc": "最小对象面积（µm²）"
    },
    "max_area_um2": {
      "type": "number",
      "default": 0,
      "desc": "最大对象面积（µm²），0 = 不限"
    },
    "min_circ": {
      "type": "number",
      "default": 0,
      "desc": "最小圆度（0–1），0 = 不过滤"
    },
    "max_circ": {
      "type": "number",
      "default": 1,
      "desc": "最大圆度（0–1）"
    },
    "show_numbers": {
      "type": "bool",
      "default": true,
      "desc": "轮廓图上标编号"
    }
  },
  "accept": {
    "min_objects": 1,
    "max_objects": 50000,
    "area_fraction": [
      0.0001,
      0.9
    ],
    "unit": "um"
  }
}
